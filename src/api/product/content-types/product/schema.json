{
  "kind": "collectionType",
  "collectionName": "products",
  "info": {
    "singularName": "product",
    "pluralName": "products",
    "displayName": "product"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "price": {
      "type": "decimal",
      "required": true
    },
    "oldPrice": {
      "type": "decimal"
    },
    "category": {
      "type": "enumeration",
      "enum": [
        "perfumes",
        "clothes",
        "shoes"
      ]
    },
    "description": {
      "type": "blocks"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "badge": {
      "type": "string"
    },
    "rating": {
      "type": "decimal",
      "required": true,
      "min": 1,
      "max": 5
    },
    "stock": {
      "type": "integer",
      "required": true
    }
  }
}
